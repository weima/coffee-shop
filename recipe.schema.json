{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Coffee Shop Recipe",
  "type": "object",
  "additionalProperties": false,
  "required": ["shots"],
  "properties": {
    "order": { "type": "string", "minLength": 1 },
    "order_file": { "type": "string", "minLength": 1 },
    "preamble": { "type": "string", "minLength": 1 },
    "preamble_file": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "pattern": "^\\S+$" },
    "thinking": { "$ref": "#/$defs/thinking" },
    "review_model": { "type": "string", "pattern": "^(|[^/\\u0000-\\u0020'\"\\\\][^\\u0000-\\u0020'\"\\\\]*)$" },
    "review_thinking": { "$ref": "#/$defs/thinking" },
    "workers": { "type": "integer", "minimum": 1, "maximum": 5, "default": 2 },
    "share": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "shots": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$" },
          "prompt": { "type": "string", "minLength": 1 },
          "prompt_file": { "type": "string", "minLength": 1 },
          "model": { "type": "string", "pattern": "^\\S+$" },
          "thinking": { "$ref": "#/$defs/thinking" },
          "expect_changes": { "type": "boolean", "default": false }
        },
        "oneOf": [
          { "required": ["prompt"], "not": { "required": ["prompt_file"] } },
          { "required": ["prompt_file"], "not": { "required": ["prompt"] } }
        ]
      }
    }
  },
  "oneOf": [
    { "required": ["order"], "not": { "required": ["order_file"] } },
    { "required": ["order_file"], "not": { "required": ["order"] } }
  ],
  "allOf": [
    { "not": { "required": ["preamble", "preamble_file"] } }
  ],
  "$defs": { "thinking": { "type": "string", "enum": ["off", "minimal", "low", "medium", "high", "xhigh", "max"] } }
}
