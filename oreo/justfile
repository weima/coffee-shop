set shell := ["sh", "-cu"]

# Type-check the SQLite package as a library (it has no main entry point).
check:
    odin check src/sqlite -no-entry-point
    odin check src/store -collection:oreo=src -no-entry-point
    odin check src/script -collection:oreo=src -no-entry-point
    odin check src -collection:oreo=src -no-entry-point
    # The host is a package main, so it has an entry point. The pi extension
    # spawns the built host from oreo/bin/oreo-host.bin.
    odin check host -collection:oreo=src

# Build the single Oreo work host used by the Pi extension.
build-host:
    #!/bin/sh
    set -eu
    build_dir=$(mktemp -d "${TMPDIR:-/tmp}/oreo-host.XXXXXX")
    trap 'rm -rf "$build_dir"' EXIT
    mkdir -p bin
    cc -O2 -DSQLITE_THREADSAFE=1 -DSQLITE_OMIT_LOAD_EXTENSION -c src/sqlite/vendor/sqlite3.c -o "$build_dir/sqlite3.o"
    odin build host -collection:oreo=src -extra-linker-flags:"$build_dir/sqlite3.o" -out:bin/oreo-host.bin

# Compile the bundled amalgamation and link it into the package tests.
test: check
    #!/bin/sh
    set -eu
    build_dir=$(mktemp -d "${TMPDIR:-/tmp}/oreo-sqlite.XXXXXX")
    trap 'rm -rf "$build_dir"' EXIT
    out="$build_dir/oreo-test.bin"
    cc -O2 \
        -DSQLITE_THREADSAFE=1 \
        -DSQLITE_OMIT_LOAD_EXTENSION \
        -c src/sqlite/vendor/sqlite3.c \
        -o "$build_dir/sqlite3.o"
    # ODIN_TEST_FAIL_ON_BAD_MEMORY makes the runner count leaks and bad frees as test
    # failures, so a memory error can no longer ride along with "All tests were successful."
    # `-out:` keeps the test binary and its dSYM bundle in the temporary directory.
    TZ=UTC odin test src/sqlite -out:"$out" -extra-linker-flags:"$build_dir/sqlite3.o" -define:ODIN_TEST_FAIL_ON_BAD_MEMORY=true
    TZ=UTC odin test src/store -out:"$out" -collection:oreo=src -extra-linker-flags:"$build_dir/sqlite3.o" -define:ODIN_TEST_FAIL_ON_BAD_MEMORY=true
    TZ=UTC odin test src/script -out:"$out" -collection:oreo=src -extra-linker-flags:"$build_dir/sqlite3.o" -define:ODIN_TEST_FAIL_ON_BAD_MEMORY=true
    TZ=UTC odin test src -out:"$out" -collection:oreo=src -extra-linker-flags:"$build_dir/sqlite3.o" -define:ODIN_TEST_FAIL_ON_BAD_MEMORY=true
